# 数据版（slim2）部署环境变量模板 —— 复制到 /etc/autocode/slim2.env，chmod 600，属主 root。
# 本文件是凭证的唯一来源；项目目录里不要放 File/key.txt（它的优先级高于环境变量，且会被被测代码读到）。

# ── 监听 ───────────────────────────────────────────────────────────────────
# 有反向代理时绑回环即可；否则对外暴露必须改成 0.0.0.0 并自己解决 TLS。
AUTOCODE_SLIM2_HOST=127.0.0.1
AUTOCODE_SLIM2_PORT=8767

# 用户实际在浏览器里输入的主机名，逗号分隔，**不带端口**（端口会被自动剥掉）。
# 漏写哪个，访问哪个就 403 FORBIDDEN_HOST。IP 与域名共用时两个都要写。
AUTOCODE_SLIM2_ALLOWED_HOSTS=code.example.com,10.0.0.12

# 只有确实在反向代理后面才设 1；服务器直接对公网暴露时必须设 0。
#   设 0（默认、直连）：按 TCP 对端 IP 分桶。伪造 X-Forwarded-For 无效。
#   设 1（在 Caddy/nginx 后面）：按 X-Forwarded-For 的**最后一段**分桶。
#   设 1 但实际是直连 = 限流形同虚设：攻击者每次换一个假 XFF 就是新桶。
#   设 0 但实际在代理后面 = 全站共用一个桶，任何人错 5 次锁住所有人 10 分钟。
AUTOCODE_SLIM2_TRUST_PROXY=0

# ── 存储与凭证 ─────────────────────────────────────────────────────────────
AUTOCODE_SLIM2_DB=/opt/autocode/data/slim2.db
AUTOCODE_SLIM2_CREDENTIALS=/opt/autocode/data/slim2-credentials.json
AUTOCODE_SLIM2_USER=autocode

# 二选一：
#   A) 留空 —— 首次启动生成随机密码，写到 data/slim2-initial-password.txt（登录后删掉该文件）
#   B) 填哈希 —— 在服务器上执行 `python -m autocode.slim2.passwd` 生成，形如 scrypt$16384$8$1$...
# AUTOCODE_SLIM2_PASSWORD_HASH=

# ── 模型 ───────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-replace-me
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
# 官网当前型号名（V4.1 Flash，原生多模态）。旧名 deepseek-v4-flash / deepseek-chat
# 已下线或路由异常：实测 deepseek-chat 生成测试数据时会把输出预算烧空、content 为空。
DEEPSEEK_MODEL=deepseek-flash

# ── 生成策略 ───────────────────────────────────────────────────────────────
# 题面没解析出样例时是否仍允许生成测试数据。
#   0（默认）：允许，但结果里标「未经样例锚定」，标程实跑只做交叉核对
#   1：严格模式，没样例直接拒绝生成（老行为）
AUTOCODE_SLIM2_REQUIRE_SAMPLES=0

# ── 执行隔离 ───────────────────────────────────────────────────────────────
# bwrap（推荐）| 空（仅 systemd 硬化，不建议公网）
AUTOCODE_SANDBOX=bwrap
