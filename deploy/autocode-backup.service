[Unit]
Description=autoCode Slim 数据库备份（每 4 小时）
Documentation=file:/opt/autocode/deploy/backup.sh
After=autocode-slim.service

[Service]
Type=oneshot
User=root
ExecStart=/opt/autocode/deploy/backup.sh
Nice=10
IOSchedulingClass=idle
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ReadWritePaths=/var/backups/autocode

[Install]
WantedBy=multi-user.target
